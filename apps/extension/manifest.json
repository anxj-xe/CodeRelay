{
  "manifest_version": 3,
  "name": "CodeRelay",
  "version": "0.1.0",
  "description": "Automatically capture accepted coding solutions and sync them to your local Git repository.",
  "key": "",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://leetcode.com/*",
    "*://127.0.0.1/*",
    "*://localhost/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CodeRelay Status"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://leetcode.com/problems/*"],
      "js": ["src/interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://leetcode.com/problems/*"],
      "js": ["src/content.js"],
      "run_at": "document_end"
    }
  ]
}
