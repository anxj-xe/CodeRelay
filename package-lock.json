{
  "name": "coderelay",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "coderelay",
      "version": "0.1.0",
      "license": "MIT",
      "workspaces": [
        "apps/*",
        "packages/*",
        "packages/platform-adapters/*"
      ],
      "devDependencies": {
        "typescript": "^6.0.3"
      },
      "engines": {
        "node": ">=24"
      }
    },
    "apps/cli": {
      "name": "@coderelay/cli",
      "version": "0.1.0"
    },
    "apps/extension": {
      "name": "@coderelay/extension",
      "version": "0.1.0"
    },
    "node_modules/@coderelay/cli": {
      "resolved": "apps/cli",
      "link": true
    },
    "node_modules/@coderelay/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@coderelay/extension": {
      "resolved": "apps/extension",
      "link": true
    },
    "node_modules/@coderelay/git": {
      "resolved": "packages/git",
      "link": true
    },
    "node_modules/@coderelay/leetcode": {
      "resolved": "packages/platform-adapters/leetcode",
      "link": true
    },
    "node_modules/@coderelay/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/typescript": {
      "version": "6.0.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-6.0.3.tgz",
      "integrity": "sha512-y2TvuxSZPDyQakkFRPZHKFm+KKVqIisdg9/CZwm9ftvKXLP8NRWj38/ODjNbr43SsoXqNuAisEf1GdCxqWcdBw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/core": {
      "name": "@coderelay/core",
      "version": "0.1.0",
      "dependencies": {
        "@coderelay/shared": "0.1.0"
      }
    },
    "packages/git": {
      "name": "@coderelay/git",
      "version": "0.1.0"
    },
    "packages/platform-adapters/leetcode": {
      "name": "@coderelay/leetcode",
      "version": "0.1.0"
    },
    "packages/shared": {
      "name": "@coderelay/shared",
      "version": "0.1.0"
    }
  }
}
