{
  "name": "coderelay",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source tool to capture coding submissions and sync them to Git repositories.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/platform-adapters/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
