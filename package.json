{
  "name": "coderelay",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source tool to capture coding submissions and sync them to Git repositories.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/platform-adapters/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
